---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const experience = [
	{
		period: '2024 — 2026',
		role: 'L2 Technical Support Analyst',
		company: 'Aptius Software',
		description: 'Supported clients on the Administra ERP (Grupo Argus): XML validation, invoice sequencing, CABYS classification, cryptographic certificates, diplomatic exemption invoices and user permission management. Trained new businesses on traditional tax regime and electronic invoicing requirements.',
		tags: ['ERP', 'Electronic invoicing', 'CABYS', 'L2 Support'],
	},
	{
		period: 'Before Aptius',
		role: 'Hardware Technician',
		company: 'Independent',
		description: 'Diagnosis and repair of equipment. Technical foundation that naturally extended into software support as I took on more system responsibilities.',
		tags: ['Hardware', 'Diagnostics'],
	},
	{
		period: 'Currently',
		role: 'Cloud & DevOps Training',
		company: 'Platzi — self-taught',
		description: 'Self-directed learning, applied to personal projects like PickLab.',
		tags: ['Cloud', 'DevOps', 'Python'],
	},
];
---

<Layout>
	<section class="max-w-5xl mx-auto px-6 pt-20 pb-10">
		<p class="reveal font-mono text-xs uppercase tracking-widest text-primary mb-3">{t('experiencia.eyebrow')}</p>
		<h1 class="reveal text-4xl md:text-5xl font-bold text-on-surface mb-4" style="transition-delay: 100ms">{t('experiencia.title')}</h1>
		<p class="reveal text-lg text-on-surface-variant max-w-xl" style="transition-delay: 200ms">
			{t('experiencia.subtitle')}
		</p>
	</section>

	<section class="max-w-5xl mx-auto px-6 pb-24">
		<div class="relative pl-10">
			<div class="absolute left-0 top-0 bottom-0 w-px bg-outline-variant"></div>
			<div class="timeline-fill absolute left-0 top-0 w-px bg-primary origin-top"></div>

			<div class="space-y-14">
				{experience.map((item, index) => (
					<div class="reveal relative group" style={`transition-delay: ${index * 120}ms`}>
						<div class="absolute -left-[45px] top-0 w-8 h-8 rounded-full bg-surface border-2 border-primary flex items-center justify-center group-hover:scale-110 transition-transform">
							<span class="w-2 h-2 rounded-full bg-primary"></span>
						</div>

						<span class="font-mono text-xs uppercase tracking-widest text-outline">
							{item.period}
						</span>

						<h2 class="text-2xl font-bold text-on-surface mt-2 mb-1">
							{item.role}
						</h2>

						<p class="font-mono text-sm text-primary mb-4">
							{item.company}
						</p>

						<p class="text-on-surface-variant max-w-2xl mb-4">
							{item.description}
						</p>

						<div class="flex flex-wrap gap-2">
							{item.tags.map((tag) => (
								<span class="font-mono text-xs text-secondary border border-outline-variant rounded px-2 py-1">
									{tag}
								</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<script>
		function setupTimelineFill() {
			const container = document.querySelector('.relative.pl-10') as HTMLElement;
			const fill = document.querySelector('.timeline-fill') as HTMLElement;
			if (!container || !fill) return;

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							const height = container.getBoundingClientRect().height;
							fill.style.height = `${height}px`;
							fill.style.transform = 'scaleY(1)';
						}
					});
				},
				{ threshold: 0.05 }
			);
			observer.observe(container);
		}

		setupTimelineFill();
		document.addEventListener('astro:page-load', setupTimelineFill);
	</script>

	<style>
		.timeline-fill {
			height: 100%;
			transform: scaleY(0);
			transition: transform 2s ease-out;
		}
	</style>
</Layout>